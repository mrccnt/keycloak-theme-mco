# keycloak-theme-mco: Keycloak login theme (Keycloak >= 26.1.4)
#
#   make            -> dist/keycloak-theme-mco-<version>.jar (copy to /opt/keycloak/providers/)
#                      plus checksums, SBOMs and reports
#   make theme      -> unpacked theme under build/theme/ (for Docker mount / development)
#   make dev        -> start Keycloak 26.1.4 via Docker Compose with the theme mounted
#   make watch      -> recompile SCSS on change
#   make checksums  -> MD5/SHA-256 files of the JAR (dist/*.jar.md5, dist/*.jar.sha256)
#   make sbom       -> SBOMs of the JAR (dist/*.cdx.json CycloneDX, dist/*.spdx.json SPDX)
#   make report     -> reports under build/reports/ (npm audit, licenses, JAR contents)
#   make lint       -> FreeMarker syntax check of all .ftl templates (+ build/reports/ftl-lint.txt)
#   make clean      -> delete build/ and dist/
#   make distclean  -> additionally delete node_modules/ and the download cache

PACKAGE      := keycloak-theme-mco
THEME        := $(PACKAGE)
VERSION      ?= 1.0.0
KC_VERSION   := 26.1.4

# Source Sans Pro is downloaded from Fontsource and self-hosted in the theme
FONT_FAMILY  := source-sans-pro
FONT_VERSION := 5.2.5
FONT_CDN     := https://cdn.jsdelivr.net/fontsource/fonts/$(FONT_FAMILY)@$(FONT_VERSION)
FONT_WEIGHTS := 300 400 600 700
FONT_SUBSETS := latin latin-ext cyrillic cyrillic-ext greek

# Only these Bootstrap Icons end up in the theme (name = file name in bootstrap-icons/icons/)
ICONS := \
	arrow-counterclockwise arrow-right box-arrow-in-right box-arrow-left check-circle \
	chevron-down chevron-right envelope exclamation-circle exclamation-triangle eye eye-slash \
	fingerprint globe info-circle key list-check person person-plus phone qr-code \
	shield-check shield-lock usb-drive bluetooth wifi \
	facebook github gitlab google instagram linkedin microsoft paypal stack-overflow twitter-x

SRC       := src
BUILD     := build
DIST      := dist
CACHE     := .cache
NODE      := node_modules

THEME_SRC := $(SRC)/theme/$(THEME)
THEME_OUT := $(BUILD)/theme/$(THEME)
RES_OUT   := $(THEME_OUT)/login/resources
GEN       := $(BUILD)/gen
JAR       := $(DIST)/$(PACKAGE)-$(VERSION).jar
CHECKSUMS := $(JAR).md5 $(JAR).sha256
SBOM_CDX  := $(DIST)/$(PACKAGE)-$(VERSION).cdx.json
SBOM_SPDX := $(DIST)/$(PACKAGE)-$(VERSION).spdx.json
REPORTS   := $(BUILD)/reports

SASS      := $(NODE)/.bin/sass
SASS_OPTS := --no-source-map --style=compressed --quiet-deps \
             --load-path=$(NODE) --load-path=$(GEN)

# FreeMarker version bundled with Keycloak 26.1.4 (used for `make lint`)
FREEMARKER_VERSION := 2.3.32
FREEMARKER_JAR     := $(CACHE)/freemarker-$(FREEMARKER_VERSION).jar
FREEMARKER_URL     := https://repo1.maven.org/maven2/org/freemarker/freemarker/$(FREEMARKER_VERSION)/freemarker-$(FREEMARKER_VERSION).jar

FONT_FILES := $(foreach s,$(FONT_SUBSETS),$(foreach w,$(FONT_WEIGHTS),$(RES_OUT)/fonts/$(FONT_FAMILY)-$(s)-$(w)-normal.woff2))
ICON_FILES := $(ICONS:%=$(RES_OUT)/img/icons/%.svg)
IMG_FILES  := $(RES_OUT)/img/logo.png $(RES_OUT)/img/favicon.ico \
              $(RES_OUT)/img/image_1.webp $(RES_OUT)/img/image_2.webp
SCSS_FILES := $(shell find $(SRC)/scss -name '*.scss')
TPL_FILES  := $(shell find $(THEME_SRC) -type f)
CSS_FILE   := $(RES_OUT)/css/login.css
FTL_FILES  := $(shell find $(THEME_SRC) -name '*.ftl')

.PRECIOUS: $(CACHE)/fonts/%.woff2

.PHONY: all theme deps fonts icons images css jar checksums sbom report lint dev watch clean distclean

all: jar checksums sbom report

theme: $(BUILD)/.theme-copied fonts icons images css

deps: $(NODE)/.installed

fonts: $(FONT_FILES)
icons: $(ICON_FILES)
images: $(IMG_FILES)
css: $(CSS_FILE)
jar: $(JAR)
checksums: $(CHECKSUMS)
sbom: $(SBOM_CDX) $(SBOM_SPDX)
report: $(REPORTS)/npm-audit.json $(REPORTS)/npm-audit.txt $(REPORTS)/licenses.txt $(REPORTS)/jar-contents.txt

$(NODE)/.installed: package.json
	npm install --no-audit --no-fund
	@touch $@

# --- Templates, properties, messages ----------------------------------------
$(BUILD)/.theme-copied: $(TPL_FILES)
	@mkdir -p $(THEME_OUT)
	cp -r $(THEME_SRC)/. $(THEME_OUT)/
	@touch $@

# --- Fonts (download into cache, then copy into the theme) -------------------
$(CACHE)/fonts/%.woff2:
	@mkdir -p $(@D)
	curl -fsSL -o $@ $(FONT_CDN)/$(subst $(FONT_FAMILY)-,,$*).woff2

$(RES_OUT)/fonts/%.woff2: $(CACHE)/fonts/%.woff2
	@mkdir -p $(@D)
	cp $< $@

# --- Icons (only those listed above) ----------------------------------------
$(RES_OUT)/img/icons/%.svg: $(NODE)/.installed
	@mkdir -p $(@D)
	cp $(NODE)/bootstrap-icons/icons/$*.svg $@

# Icon classes are generated from the same list so CSS and files stay in sync
$(GEN)/_icons.scss: Makefile
	@mkdir -p $(@D)
	@printf '// generated by make – do not edit\n$$theme-icons: (%s);\n' \
		"$(foreach i,$(ICONS),\"$(i)\",)" > $@

# --- Images ------------------------------------------------------------------
$(RES_OUT)/img/logo.png: resources/logo.png
	@mkdir -p $(@D)
	convert $< -fuzz 3% -fill none -draw "color 0,0 floodfill" -trim +repage \
		-resize 96x96 -gravity center -background none -extent 96x96 -strip $@

$(RES_OUT)/img/favicon.ico: resources/logo.png
	@mkdir -p $(@D)
	convert $< -fuzz 3% -fill none -draw "color 0,0 floodfill" -trim +repage \
		-resize 48x48 -gravity center -background none -extent 48x48 \
		-define icon:auto-resize=48,32,16 $@

$(RES_OUT)/img/%.webp: resources/%.png
	@mkdir -p $(@D)
	convert $< -resize 800x800 -strip -quality 82 $@

# --- CSS ---------------------------------------------------------------------
$(CSS_FILE): $(SCSS_FILES) $(GEN)/_icons.scss $(NODE)/.installed
	@mkdir -p $(@D)
	$(SASS) $(SASS_OPTS) $(SRC)/scss/login.scss $@

# --- JAR ---------------------------------------------------------------------
$(JAR): theme $(SRC)/META-INF/keycloak-themes.json
	@mkdir -p $(DIST) $(BUILD)/META-INF
	cp $(SRC)/META-INF/keycloak-themes.json $(BUILD)/META-INF/
	rm -f $@
	cd $(BUILD) && zip -qr ../$@ META-INF theme
	@echo "-> $@"

# --- Checksums (relative file name, so `md5sum -c` / `sha256sum -c` work in dist/) ---
$(JAR).md5: $(JAR)
	cd $(DIST) && md5sum $(notdir $<) > $(notdir $@)

$(JAR).sha256: $(JAR)
	cd $(DIST) && sha256sum $(notdir $<) > $(notdir $@)

# --- SBOM (npm sbom from package-lock.json, enriched with JAR hashes and the font) ---
$(BUILD)/npm-sbom.%.json: package-lock.json
	@mkdir -p $(@D)
	npm sbom --package-lock-only --sbom-format $* --sbom-type application > $@

$(SBOM_CDX): $(BUILD)/npm-sbom.cyclonedx.json $(JAR) tools/sbom.mjs
	node tools/sbom.mjs cyclonedx $< $(JAR) $(PACKAGE) $(VERSION) $(FONT_FAMILY) $(FONT_VERSION) > $@

$(SBOM_SPDX): $(BUILD)/npm-sbom.spdx.json $(JAR) tools/sbom.mjs
	node tools/sbom.mjs spdx $< $(JAR) $(PACKAGE) $(VERSION) $(FONT_FAMILY) $(FONT_VERSION) > $@

# --- Reports (informational, they do not fail the build) ---------------------
$(REPORTS)/npm-audit.json: package-lock.json
	@mkdir -p $(@D)
	npm audit --json > $@ || true

$(REPORTS)/npm-audit.txt: package-lock.json
	@mkdir -p $(@D)
	npm audit > $@ || true

$(REPORTS)/licenses.txt: $(SBOM_CDX) tools/sbom.mjs
	@mkdir -p $(@D)
	node tools/sbom.mjs licenses $< > $@

$(REPORTS)/jar-contents.txt: $(JAR)
	@mkdir -p $(@D)
	unzip -l $< > $@

# --- Lint --------------------------------------------------------------------
$(FREEMARKER_JAR):
	@mkdir -p $(@D)
	curl -fsSL -o $@ $(FREEMARKER_URL)

lint: $(FREEMARKER_JAR)
	@mkdir -p $(REPORTS)
	java -cp $(FREEMARKER_JAR) tools/FtlLint.java $(FTL_FILES) > $(REPORTS)/ftl-lint.txt 2>&1; \
		rc=$$?; cat $(REPORTS)/ftl-lint.txt; exit $$rc

# --- Development -------------------------------------------------------------
dev: theme
	KC_VERSION=$(KC_VERSION) docker compose up

watch: deps $(GEN)/_icons.scss
	$(SASS) $(SASS_OPTS) --watch $(SRC)/scss/login.scss:$(CSS_FILE)

clean:
	rm -rf $(BUILD) $(DIST)

distclean: clean
	rm -rf $(NODE) $(CACHE)
